{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hubplc",
  "main": "./locale-worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hubplc.com", "custom_domain": true }],
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/locale",
      "/tool/volts-to-watts",
      "/tool/volts-to-watts/",
      "/tool/volts-to-amps",
      "/tool/volts-to-amps/",
      "/tool/watts-to-kva",
      "/tool/watts-to-kva/",
      "/tool/kva-to-va",
      "/tool/kva-to-va/",
      "/tool/kw-to-kwh",
      "/tool/kw-to-kwh/",
      "/tool/watts-to-kwh",
      "/tool/watts-to-kwh/",
      "/tool/kwh-to-watts",
      "/tool/kwh-to-watts/",
    ],
    "not_found_handling": "404-page",
  },
}
